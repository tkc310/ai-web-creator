// フォームを自前で作るときに、wrangler.jsonc に足す設定の例。
// <...> を埋める。秘密の鍵（TURNSTILE_SECRET_KEY）はここに書かず、Cloudflare の画面で Secret として登録する。
{
  // HTML だけのサイトの場合（Astro では adapter の設定に従い、main は "@astrojs/cloudflare/entrypoints/server"）
  "main": "src/worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/ だけ Worker を先に通し、ほかのページはファイルをそのまま返す
    "run_worker_first": ["/api/*"]
  },

  // Email Sending でメールを送るための接続。鍵は要らない
  "send_email": [{ "name": "EMAIL" }],

  // 秘密でない設定
  "vars": {
    "CONTACT_TO": "<通知を受けるアドレス。Cloudflare で確認済みのもの>",
    "CONTACT_FROM": "form@<Email Sending に登録したドメイン>",
    "SITE_ORIGIN": "https://<本番のドメイン>"
  }
}
