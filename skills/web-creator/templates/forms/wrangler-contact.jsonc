// フォームを自前で作るときに、wrangler.jsonc に足す設定の例（Astro ＋ @astrojs/cloudflare）。
// <...> を埋める。秘密の鍵（TURNSTILE_SECRET_KEY）はここに書かず、Workers の Secret として登録する。
// main と静的アセットの設定は @astrojs/cloudflare のドキュメントに従う（Astro 6 以降は main に
// "@astrojs/cloudflare/entrypoints/server" を指定し、静的アセットの設定はアダプターが行う。build.md）。
{
  // Email Sending でメールを送るための接続。鍵は要らない
  "send_email": [{ "name": "EMAIL" }],

  // 秘密でない設定
  "vars": {
    "CONTACT_TO": "<通知を受けるアドレス。Cloudflare で確認済みのもの>",
    "CONTACT_FROM": "form@<Email Sending に登録したドメイン>",
    "SITE_ORIGIN": "https://<本番のドメイン>"
  }
}
